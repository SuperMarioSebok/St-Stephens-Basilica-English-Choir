[Unit]
Description=Basilica Voice Coach audio render worker
After=network.target

[Service]
User=bvc
WorkingDirectory=/opt/bvc/app/backend
ExecStart=/opt/bvc/app/backend/.venv/bin/python -m bvc.worker --data-dir /opt/bvc/data
Restart=on-failure
Nice=10
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
